{
  "name": "gamenetworkingsockets",
  "version": "1.6.1",
  "description": "GameNetworkingSockets transport with matching Protobuf linkage",
  "homepage": "https://github.com/ValveSoftware/GameNetworkingSockets",
  "license": "BSD-3-Clause",
  "supports": "!uwp & !(arm64 & windows)",
  "dependencies": [
    "openssl",
    "protobuf",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "ice"
  ],
  "features": {
    "ice": {
      "description": "Native ICE client for P2P connections (STUN and TURN)"
    }
  }
}
