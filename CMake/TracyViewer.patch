@@ -26,8 +26,22 @@ bool WasActive()
 
 void DrawZigZag( ImDrawList* draw, const ImVec2& wpos, double start, double end, double h, uint32_t color )
 {
+#ifdef MIKOTO_TRACY_EMBEDDED
+    if( h <= 0 || end <= start ) return;
+    const auto clipMin = draw->GetClipRectMin().x - wpos.x;
+    const auto clipMax = draw->GetClipRectMax().x - wpos.x;
+    const auto first = std::max( 0.0, floor( ( clipMin - start ) / ( h * 2 ) ) ) * 2;
+    const auto last = std::min( end, clipMax + h );
+    for( double x = start + first * h; x < last; x += h * 2 )
+    {
+        const auto peak = std::min( x + h, end );
+        draw->AddLine( wpos + ImVec2( x, -h ), wpos + ImVec2( peak, h ), color );
+        if( peak < end ) draw->AddLine( wpos + ImVec2( peak, h ), wpos + ImVec2( std::min( x + h * 2, end ), -h ), color );
+    }
+#else
     const auto v = ( end - start ) / ( h * 2 );
     draw->AddImage( zigzagTex, wpos + ImVec2( start, -h ), wpos + ImVec2( end, h ), ImVec2( 0, 0 ), ImVec2( v, 1 ), color );
+#endif
 }
 
 void DrawStripedRect( ImDrawList* draw, const ImVec2& wpos, double x0, double y0, double x1, double y1, double sw, uint32_t color, bool fix_stripes_in_screen_space, bool inverted )
