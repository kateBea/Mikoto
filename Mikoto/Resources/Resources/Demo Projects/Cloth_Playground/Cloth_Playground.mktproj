# Press Simulate, then enable the hand tool in the Scene viewport to grab particles.
# White dots are free particles, blue are pinned, and gold marks the current grab.
Version: 1
Project: "Cloth and Soft Bodies Playground"
Assets: "Assets"
Cache: "Assets/.cache"
Scene: "Scene/Cloth_Playground.mktscn"
CompressTextures: false
AutoSave: false
AutoSaveIntervalMs: 2000
EditorCamera:
  NavigationMode: "Fly"
  Position: [8.5, 8, 17.5]
  Direction: [-0.41810077, -0.29021112, -0.86079571]
  Projection: "Perspective"
  FieldOfView: 48
  NearPlane: 0.1
  FarPlane: 500
  MovementSpeed: 9
  RotationSpeed: 10
  SmoothTime: 0.1
  AllowPitch: true
  AllowYaw: true
