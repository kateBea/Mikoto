# Use Simulate and the Grab Soft Body viewport tool. Drag up to lift a corner.
# Compare a full pole seam to two corner pins, a pinned drape to a free drape,
# and two closed soft spheres with different internal pressures.
# The procedural atmosphere provides the visible sky and filtered IBL.
Version: 5
RelativeAssetPaths: true
Scene: "Cloth and Soft Bodies Playground"
EnvironmentLightingSource: 2
ToneMapping: 0
Atmosphere:
  UseDirectionalLight: false
  SunElevation: 44
  SunAzimuth: 135
  SunIlluminance: 8
  AerialPerspective: true
Objects:
  -
    Type: 5
    ID: 1
    TagComponent:
      Name: "Ground"
      Visibility: true
    TransformComponent:
      Position: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Ground.gltf"
    MaterialComponent:
      Reference: 0
    BoxColliderComponent:
      HalfExtents: [18, 0.2, 13]
      Offset: [0, -0.2, 0]
      Trigger: false
  -
    Type: 5
    ID: 2
    TagComponent:
      Name: "Full-seam flag pole"
      Visibility: true
    TransformComponent:
      Position: [-6.45, 2.45, -3.5]
      Rotation: [0, 0, 0]
      Scale: [0.08, 2.45, 0.08]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Box.gltf"
    MaterialComponent:
      Reference: 1
    BoxColliderComponent:
      HalfExtents: [1, 1, 1]
      Offset: [0, 0, 0]
      Trigger: false
  # The blue markers show exactly which imported vertex indices are pinned.
  -
    Type: 5
    ID: 3
    TagComponent:
      Name: "Full-seam flag"
      Visibility: true
    TransformComponent:
      Position: [-6.3, 4.62, -3.5]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Flag.gltf"
    MaterialComponent:
      Reference: 2
    ClothComponent:
      VertexMass: 0.045
      GravityFactor: 1
      LinearDamping: 0.25
      Pressure: 0
      EdgeCompliance: 0.000002
      BendCompliance: 0.00004
      PinnedVertices: [0, 19, 38, 57, 76, 95, 114, 133, 152, 171, 190, 209, 228]
      Enabled: true
  -
    Type: 5
    ID: 4
    TagComponent:
      Name: "Two-corner flag pole"
      Visibility: true
    TransformComponent:
      Position: [2.5500000000000003, 2.45, -3.5]
      Rotation: [0, 0, 0]
      Scale: [0.08, 2.45, 0.08]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Box.gltf"
    MaterialComponent:
      Reference: 1
    BoxColliderComponent:
      HalfExtents: [1, 1, 1]
      Offset: [0, 0, 0]
      Trigger: false
  -
    Type: 5
    ID: 5
    TagComponent:
      Name: "Corner flag crossbar"
      Visibility: true
    TransformComponent:
      Position: [4.0200000000000005, 4.75, -3.5]
      Rotation: [0, 0, 0]
      Scale: [1.55, 0.055, 0.055]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Box.gltf"
    MaterialComponent:
      Reference: 1
    BoxColliderComponent:
      HalfExtents: [1, 1, 1]
      Offset: [0, 0, 0]
      Trigger: false
  # The blue markers show exactly which imported vertex indices are pinned.
  -
    Type: 5
    ID: 6
    TagComponent:
      Name: "Two-corner flag"
      Visibility: true
    TransformComponent:
      Position: [2.7, 4.62, -3.5]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Flag.gltf"
    MaterialComponent:
      Reference: 3
    ClothComponent:
      VertexMass: 0.045
      GravityFactor: 1
      LinearDamping: 0.25
      Pressure: 0
      EdgeCompliance: 0.000002
      BendCompliance: 0.00004
      PinnedVertices: [0, 18]
      Enabled: true
  -
    Type: 5
    ID: 7
    TagComponent:
      Name: "Pinned drape collision sphere"
      Visibility: true
    TransformComponent:
      Position: [-4, 1.12, 2]
      Rotation: [0, 0, 0]
      Scale: [1.12, 1.12, 1.12]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Sphere.gltf"
    MaterialComponent:
      Reference: 6
    SphereColliderComponent:
      Radius: 1
      Offset: [0, 0, 0]
      Trigger: false
  # The cloth starts above the sphere. Try lifting an edge after it settles.
  -
    Type: 5
    ID: 8
    TagComponent:
      Name: "Pinned drape"
      Visibility: true
    TransformComponent:
      Position: [-4, 2.8, 2]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Drape.gltf"
    MaterialComponent:
      Reference: 4
    ClothComponent:
      VertexMass: 0.045
      GravityFactor: 1
      LinearDamping: 0.25
      Pressure: 0
      EdgeCompliance: 0.000002
      BendCompliance: 0.00008
      PinnedVertices: [0, 20]
      Enabled: true
  -
    Type: 5
    ID: 9
    TagComponent:
      Name: "Free drape collision sphere"
      Visibility: true
    TransformComponent:
      Position: [0.7, 1.12, 2]
      Rotation: [0, 0, 0]
      Scale: [1.12, 1.12, 1.12]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Sphere.gltf"
    MaterialComponent:
      Reference: 6
    SphereColliderComponent:
      Radius: 1
      Offset: [0, 0, 0]
      Trigger: false
  # The cloth starts above the sphere. Try lifting an edge after it settles.
  -
    Type: 5
    ID: 10
    TagComponent:
      Name: "Free drape"
      Visibility: true
    TransformComponent:
      Position: [0.7, 2.8, 2]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Drape.gltf"
    MaterialComponent:
      Reference: 5
    ClothComponent:
      VertexMass: 0.045
      GravityFactor: 1
      LinearDamping: 0.25
      Pressure: 0
      EdgeCompliance: 0.000002
      BendCompliance: 0.00008
      PinnedVertices: []
      Enabled: true
  -
    Type: 5
    ID: 11
    TagComponent:
      Name: "Soft-body landing slab"
      Visibility: true
    TransformComponent:
      Position: [6.4, 0.2, 3.85]
      Rotation: [0, 0, 0]
      Scale: [2.6, 0.2, 2.3]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Box.gltf"
    MaterialComponent:
      Reference: 1
    BoxColliderComponent:
      HalfExtents: [1, 1, 1]
      Offset: [0, 0, 0]
      Trigger: false
  # Both soft spheres share topology, mass and stretch settings. Pressure is the variable.
  -
    Type: 5
    ID: 12
    TagComponent:
      Name: "Soft sphere - low pressure"
      Visibility: true
    TransformComponent:
      Position: [5.25, 2.9, 3.9]
      Rotation: [0, 0, 0]
      Scale: [0.92, 0.92, 0.92]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Sphere.gltf"
    MaterialComponent:
      Reference: 7
    SoftBodyComponent:
      VertexMass: 0.15
      GravityFactor: 1
      LinearDamping: 0.22
      Pressure: 90
      EdgeCompliance: 0.00008
      PinnedVertices: []
      Enabled: true
  -
    Type: 5
    ID: 13
    TagComponent:
      Name: "Soft sphere - high pressure"
      Visibility: true
    TransformComponent:
      Position: [7.55, 2.9, 3.9]
      Rotation: [0, 0, 0]
      Scale: [0.92, 0.92, 0.92]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Sphere.gltf"
    MaterialComponent:
      Reference: 8
    SoftBodyComponent:
      VertexMass: 0.15
      GravityFactor: 1
      LinearDamping: 0.22
      Pressure: 1600
      EdgeCompliance: 0.00008
      PinnedVertices: []
      Enabled: true
  -
    Type: 6
    ID: 14
    TagComponent:
      Name: "Camera"
      Visibility: true
    TransformComponent:
      Position: [8.5, 8, 17.5]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
      Local Transform:
        - [0.89950816, 0, -0.43690396, 0]
        - [-0.12679439, 0.95696264, -0.26104727, 0]
        - [0.41810077, 0.29021112, 0.86079571, 0]
        - [8.5, 8, 17.5, 1]
    Children: []
    CameraComponent:
      Projection: 1
      Fov: 48
      Near: 0.1
      Far: 500
      Main: true
      FixedAspect: false
      ClearFlags: 2
      ClearColor: [0.02, 0.025, 0.035, 1]
      Gamma: 2.2
      Exposure: 1
  -
    Type: 3
    ID: 15
    TagComponent:
      Name: "Sun shadows"
      Visibility: true
    TransformComponent:
      Position: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    Children: []
    LightComponent:
      Type: 0
      Directional:
        Color: [1.0, 0.93, 0.82]
        Intensity: 3
        Direction: [0.50865005, -0.69465837, 0.50865005]
        CastShadows: true
Materials:
  - MaterialPath: "../Assets/Materials/Ground.mktmtl"
  - MaterialPath: "../Assets/Materials/Fixture.mktmtl"
  - MaterialPath: "../Assets/Materials/Coral Flag.mktmtl"
  - MaterialPath: "../Assets/Materials/Blue Flag.mktmtl"
  - MaterialPath: "../Assets/Materials/Gold Drape.mktmtl"
  - MaterialPath: "../Assets/Materials/Teal Drape.mktmtl"
  - MaterialPath: "../Assets/Materials/Stone Sphere.mktmtl"
  - MaterialPath: "../Assets/Materials/Low Pressure.mktmtl"
  - MaterialPath: "../Assets/Materials/High Pressure.mktmtl"
