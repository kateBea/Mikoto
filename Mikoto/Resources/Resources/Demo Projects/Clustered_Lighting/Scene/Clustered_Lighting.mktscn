# Clustered lighting stress demo: Sponza at the center of a 120 by 96 ground plane.
# Of 15,000 lights, 3,000 stay in the atrium and 12,000 are scattered around it.
# Exterior samples use seed 20261108 within X [-53, 53] and Z [-41, 41], clear of the model.
# Outside, point lights hover near the surface and higher spotlights sweep across the ground.
# Press Play to animate position, intensity, range and spot direction. Simulate runs physics only.
# Shadows are disabled to isolate local-light culling and shading cost.
Version: 5
RelativeAssetPaths: true
Scene: "Sponza - 15,000 Animated Lights"
EnvironmentLightingSource: 2
ToneMapping: 0
Atmosphere:
  UseDirectionalLight: false
  SunElevation: 18
  SunAzimuth: 140
  SunIlluminance: 0.9
  AerialPerspective: false
Objects:
  # Resume the entire model import: every glTF primitive keeps its source material.
  # Sponza.gltf already carries a 0.008 node scale; the scene root needs no extra scaling.
  -
    Type: 0
    ID: 1
    TagComponent:
      Name: "Sponza"
      Visibility: true
    TransformComponent:
      Position: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    StreamedModelComponent:
      ModelPath: "../../../Prefabs/sponza/sponza-atrium-3/source/glTF/glTF/Sponza.gltf"
      NextMesh: 0
    Children: []
  # The plane sits below the imported atrium floor so the surfaces do not overlap.
  -
    Type: 5
    ID: 15005
    TagComponent:
      Name: "Ground Plane"
      Visibility: true
    TransformComponent:
      Position: [0, -0.08, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    Children: []
    MeshComponent:
      MeshIndex: 0
      ModelPath: "../Assets/Models/Ground.gltf"
    MaterialComponent:
      Reference: 0
  # Lights have no marker meshes, so increasing the light count does not add draw calls.

  -
    Type: 0
    ID: 2
    TagComponent:
      Name: "Animated Point Lights (13,500)"
      Visibility: true
    TransformComponent:
      Position: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    Children:
      -
        Type: 3
        ID: 3
        TagComponent:
          Name: "Point Light 00001"
          Visibility: true
        TransformComponent:
          Position: [-2.369135, 0.554989, -36.035302]
          Rotation: [0, 0, 0]
          Scale: [1, 1, 1]
          Uniform Scale: false
        Children: []
        LightComponent:
          Type: 1
          Point:
            Color: [0.447971, 1, 0.300536]
            Intensity: 0.401448
            Radius: 2.570417
            CastShadows: false
        ScriptComponent:
          Language: "Lua"
          ScriptPath: "../Assets/Scripts/Lua/ClusteredLightMotion.lua"
          ClassName: ""
