# Clustered lighting stress demo: 15,000 animated local lights in the Sponza atrium.
# 13,500 point lights and 1,500 spotlights use reproducible random samples (seed 20261108).
# Initial bounds: X [-10, 9], Y [0.6, 8], Z [-4, 3.5], in the glTF's world units.
# Motion adds at most 0.44 in X/Z and 0.30 in Y; lights remain near the atrium.
# Press Play to animate position, intensity, range and spot direction. Simulate runs physics only.
# Shadows are disabled to isolate local-light culling and shading cost.
Version: 5
RelativeAssetPaths: true
Scene: "Sponza - 15,000 Animated Lights"
EnvironmentLightingSource: 0
ToneMapping: 0
Objects:
  # Resume the entire model import: every glTF primitive keeps its source material.
  # Sponza.gltf already carries a 0.008 node scale; the scene root needs no extra scaling.
  -
    Type: 0
    ID: 1
    TagComponent:
      Name: "Sponza"
      Visibility: true
    TransformComponent:
      Position: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    StreamedModelComponent:
      ModelPath: "../../../Prefabs/sponza/sponza-atrium-3/source/glTF/glTF/Sponza.gltf"
      NextMesh: 0
    Children: []
  # Lights have no marker meshes, so increasing the light count does not add draw calls.

  -
    Type: 0
    ID: 2
    TagComponent:
      Name: "Animated Point Lights (13,500)"
      Visibility: true
    TransformComponent:
      Position: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
      Uniform Scale: false
    Children:
