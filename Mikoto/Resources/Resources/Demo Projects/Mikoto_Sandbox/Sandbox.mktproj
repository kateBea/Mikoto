# Sandbox demo project.
# A combined example of vehicles, character controllers, canvas and scene assets.
# Open this manifest in the editor; Scene selects the authored scene below.
# Assets and Cache paths are relative to this manifest.

{
  "Version": 1,
  "Project": "Mikoto_Sandbox",
  "Assets": "Assets",
  "Cache": "Assets/.cache",
  "Scene": "Scene/Sandbox.mktscn",
  "CompressTextures": false,
  "AutoSave": false,
  "AutoSaveIntervalMs": 2000
}