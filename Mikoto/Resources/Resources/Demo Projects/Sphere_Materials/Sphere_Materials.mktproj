# Sphere_Materials demo project.
# A five-by-five sphere grid compares surface materials under a common light.
# Open this manifest in the editor; Scene selects the authored scene below.
# Assets and Cache paths are relative to this manifest.
# EditorCamera configures editor navigation; the scene camera controls the Game view.

Version: 1
Project: "Sphere Materials"
Assets: "Assets"
Cache: "Assets/.cache"
Scene: "Scene/Sphere_Materials.mktscn"
CompressTextures: false
AutoSave: false
AutoSaveIntervalMs: 2000
EditorCamera:
  NavigationMode: "Fly"
  Position: [60,60,220]
  Direction: [0.0,0.0,-1.0]
  Projection: "Perspective"
  FieldOfView: 45
  NearPlane: 0.1
  FarPlane: 1000
  MovementSpeed: 12
  RotationSpeed: 10
  SmoothTime: 0.1
  AllowPitch: true
  AllowYaw: true
