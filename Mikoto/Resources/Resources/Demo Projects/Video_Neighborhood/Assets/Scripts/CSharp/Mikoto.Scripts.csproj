<Project Sdk="Microsoft.NET.Sdk">
  <!-- Match ScriptCore: the editor loads this assembly into the .NET scripting host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/.cache/**;**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Generated by the editor with this engine build's ScriptCore reference; keep it out of source. -->
  <Import Project="Mikoto.ScriptCore.generated.props" />
</Project>
