# Volumes demo project.
# Compare sky-layer clouds, a local storm cloud, box mist, global haze and a density-grid fog sphere.
# Open this manifest in the editor; Scene selects the authored scene below.
# Assets and Cache paths are relative to this manifest.
# EditorCamera configures editor navigation; the scene camera controls the Game view.

{
  "Version": 1,
  "Project": "Clouds and Fog",
  "Assets": "Assets",
  "Cache": "Assets/.cache",
  "Scene": "Scene/Volumes.mktscn",
  "CompressTextures": false,
  "AutoSave": false,
  "Renderer": {
    "Version": 1,
    "Resolution": 0,
    "Samples": 1,
    "PathTracing": true,
    "PathSamplesPerFrame": 2,
    "PathMaxBounces": 16,
    "PathMaxSamples": 4096,
    "RayTracedAmbientOcclusion": false,
    "AoSamplesPerFrame": 2,
    "AoCosineSampling": true,
    "AoMaxDistance": 0.12,
    "BloomEnabled": true,
    "BloomThreshold": 2,
    "BloomIntensity": 0.1,
    "SsaoEnabled": false
  },
  "EditorCamera": {
    "NavigationMode": "Fly",
    "Position": [
      0,
      9,
      45
    ],
    "Direction": [
      0,
      0.04,
      -0.99919968
    ],
    "Projection": "Perspective",
    "FieldOfView": 60,
    "NearPlane": 0.1,
    "FarPlane": 100000,
    "MovementSpeed": 15,
    "RotationSpeed": 10,
    "SmoothTime": 0.1,
    "AllowPitch": true,
    "AllowYaw": true
  }
}
