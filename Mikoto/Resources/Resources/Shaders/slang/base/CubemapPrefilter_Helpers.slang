// Shared scene/preview cubemap convolution.

// GGX importance-sampled environment convolution. PDF-derived sample footprints select source
// mip levels so roughness broadens reflections without undersampling the environment.

#pragma once

#include "Lighting_Helpers.slang"

// Main filtering function
float3 PrefilterEnvMap( TextureCube source, SamplerState sourceSampler, float3 R, float roughness, uint sampleCount ) {
    // The zero-roughness GGX distribution is a delta, not a finite PDF.
    // Sample it directly to avoid 0/0 in mip selection and wasted samples.
    if ( roughness <= 1e-4 ) {
        return source.SampleLevel( sourceSampler, R, 0 ).rgb;
    }

    uint NumSamples = max( sampleCount, 1u );

    float3 N = R;
    float3 V = R;

    float3 color = float3( 0, 0, 0 );
    float totalWeight = 0.0;

    uint textureWidth;
    uint textureHeight;
    uint levelCount;
    const uint lod = 0u;
    source.GetDimensions( lod, textureWidth, textureHeight, levelCount );
    float envMapDim = float( textureWidth );

    for ( uint i = 0; i < NumSamples; i++ ) {
        float2 Xi = Hammersley2D( i, NumSamples );
        float3 H = ImportanceSample_GGX( Xi, roughness, N );
        float3 L = 2.0 * dot( V, H ) * H - V;

        float NdotL = saturate( dot( N, L ) );
        if ( NdotL > 0.0 ) {
            // LearnOpenGL: Bright dots in the pre-filter convolution
            // https://learnopengl.com/PBR/IBL/Specular-IBL
            // https://chetanjags.wordpress.com/2015/08/26/image-based-lighting/
            float NdotH = saturate( dot( N, H ) );
            float HdotV = saturate( dot( H, V ) );

            // Probability density of sampling this light direction.
            float D = DistributionGGX( N, H, roughness );
            float pdf = max( D * NdotH / max( 4.0 * HdotV, 1e-6 ), 1e-6 );

            // Solid angle covered by one texel of the original cubemap.
            float texelSolidAngle = 4.0 * PI_Value / ( 6.0 * envMapDim * envMapDim );

            // Solid angle represented by this importance sample.
            float sampleSolidAngle = 1.0 / ( float( NumSamples ) * pdf );

            // Choose a source mip whose texels approximate the sample's footprint.
            // These averaged mips must already exist; they are separate from the
            // roughness-dependent output levels being generated by this pass.
            float mipLevel = 0.5 * log2( sampleSolidAngle / texelSolidAngle );

            // Existing additional filtering bias, following these implementation notes:
            // https://placeholderart.wordpress.com/2015/07/28/implementation-notes-runtime-environment-map-filtering-for-image-based-lighting/
            mipLevel += 1.0;
            mipLevel = clamp( mipLevel, 0.0, float( max( levelCount, 1u ) - 1u ) );

            float3 sampleColor = source.SampleLevel( sourceSampler, L, mipLevel ).rgb;

            color += sampleColor * NdotL;
            totalWeight += NdotL;
        }
    }

    return color / max( totalWeight, 1e-6 );
}